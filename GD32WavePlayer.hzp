      <file file_name="sound_headers/guitar.h" />
      <file file_name="sound_headers/guitar_harmony2.h" />
      <file file_name="sound_headers/guitar_riff.h" />
      <file file_name="sound_headers/guitar_small.h" />
      <file file_name="sound_headers/handpan.h" />
      <file file_name="sound_headers/handpan_c16b.h" />
      <file file_name="sound_headers/harmony8b.h" />
      <file file_name="sound_headers/haunted_organ22k.h" />
      <file file_name="sound_headers/hey_yeah32k.h" />
      <file file_name="sound_headers/into_suffering22k1c.h" />
      <file file_name="sound_headers/KillBillShort22k.h" />
      <file file_name="sound_headers/KillBillWhistle11k.h" />
      <file file_name="sound_headers/konnichiwa.h" />
      <file file_name="sound_headers/magic_gong44k.h" />
      <file file_name="sound_headers/mind_the_door.h" />
      <file file_name="sound_headers/new_rage32k.h" />
      <file file_name="sound_headers/newchallenger.h" />
      <file file_name="sound_headers/newchallenger11k.h" />
      <file file_name="sound_headers/newchallenger2.h" />
      <file file_name="sound_headers/nylon_guitar.h" />
      <file file_name="sound_headers/ocarina_melody32k.h" />
