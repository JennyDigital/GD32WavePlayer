{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GD32: Debug with ST-Link (OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "servertype": "openocd",
      "serverpath": "/usr/bin/openocd",
      "armToolchainPath": "/opt/st/stm32cubeclt_1.20.0/GNU-tools-for-STM32/bin",
      "toolchainPrefix": "arm-none-eabi",
      "gdbPath": "/opt/st/stm32cubeclt_1.20.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
      "configFiles": [
        "${workspaceFolder}/.vscode/openocd-gd32-stlink-debug.cfg"
      ],
      "interface": "swd",
      "breakAfterReset": true,
      "loadFiles": [],
      "overrideLaunchCommands": [
        "monitor reset halt"
      ],
      "executable": "${workspaceFolder}/build/GD32WavePlayer.elf",
      "preLaunchTask": "GD32: Prepare debug session"
    },
    {
      "name": "GD32: Attach with ST-Link (OpenOCD)",
      "type": "cortex-debug",
      "request": "attach",
      "cwd": "${workspaceFolder}",
      "servertype": "openocd",
      "serverpath": "/usr/bin/openocd",
      "armToolchainPath": "/opt/st/stm32cubeclt_1.20.0/GNU-tools-for-STM32/bin",
      "toolchainPrefix": "arm-none-eabi",
      "gdbPath": "/opt/st/stm32cubeclt_1.20.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
      "configFiles": [
        "${workspaceFolder}/.vscode/openocd-gd32-stlink-debug.cfg"
      ],
      "interface": "swd",
      "breakAfterReset": true,
      "overrideAttachCommands": [
        "monitor halt"
      ],
      "executable": "${workspaceFolder}/build/GD32WavePlayer.elf",
      "preLaunchTask": "GD32: Stop debug servers"
    }
  ]
}
